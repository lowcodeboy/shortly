rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /urls/{urlId} {
      // Allow reading any URL document
      allow read: if true;
      
      // Allow creation only if user is authenticated and sets their uid as userId
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.validated == false; // Ensure new URLs start unvalidated
      
      // Allow updates only by the URL creator and enforce validation rules
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid;
        
      allow delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
  }
}